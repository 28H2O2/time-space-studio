{
  "name": "time-space-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content:check": "node scripts/check-content.mjs",
    "queue:check": "node scripts/check-queue.mjs",
    "publish:daily": "node scripts/publish-daily.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run content:check && npm run queue:check && tsc --noEmit && npm test",
    "build": "npm run content:check && npm run queue:check && tsc --noEmit && vite build && node scripts/write-publication.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "react": "19.2.6", "react-dom": "19.2.6", "lucide-react": "1.31.0" },
  "devDependencies": { "@types/node": "22.19.19", "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "@vitejs/plugin-react": "6.0.2", "typescript": "5.9.3", "vite": "8.0.13" }
}
